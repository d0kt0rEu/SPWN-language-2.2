        #[desc("area easing rate")] area_easing_rate: @number | @NULL = null,
        #[desc("ease out")] ease_out: @bool | @NULL = null,
        #[desc("area easing2 See gd_enums.Easing.")] area_easing2: @number | @NULL = null,
        #[desc("area easing2 rate")] area_easing2_rate: @number | @NULL = null,
        #[desc("dir buttons dir Values: gd_enums.AreaDirButtonsDir (ALL=0, HORIZ=1, VERT=2).")] dir_buttons_dir: @number | @NULL = null,
        #[desc("dir buttons inwards")] dir_buttons_inwards: @bool | @NULL = null,
        #[desc("dir buttons double arrow")] dir_buttons_double_arrow: @bool | @NULL = null,
        #[desc("de ap")] de_ap: @bool | @NULL = null,
        #[desc("effect id")] effect_id: @number | @NULL = null,
        #[desc("center group")] center_group: @group | @trigger_function | @NULL = null,
        #[desc("priority")] priority: @number | @NULL = null,
        #[desc("center special Values: gd_enums.AreaCenterSpecial (P1=-1, P2=-2, C=-3, BL=-4, CL=-5, TL=-6, BC=-7, TC=-8, BR=-9, CR=-10, TR=-11).")] center_special: @number | @NULL = null,
        #[desc("color channel")] color_channel: @color | @NULL = null,
        #[desc("main only")] main_only: @bool | @NULL = null,
        #[desc("secondary only")] secondary_only: @bool | @NULL = null,
    ) -> @NULL {
        let o = obj { OBJ_ID: 3010 }
        if !(tint is @NULL) { $.edit_obj(o, TINT, tint) }
        if !(hsv_on is @NULL) { $.edit_obj(o, HSV_ON, hsv_on) }
        if !(hsv is @NULL) { $.edit_obj(o, HSV, hsv) }
        if !(length is @NULL) { $.edit_obj(o, LENGTH, length) }
        if !(length_pm is @NULL) { $.edit_obj(o, LENGTH_PM, length_pm) }
        if !(offset is @NULL) { $.edit_obj(o, OFFSET, offset) }
        if !(offset_pm is @NULL) { $.edit_obj(o, OFFSET_PM, offset_pm) }
        if !(offset_y is @NULL) { $.edit_obj(o, OFFSET_Y, offset_y) }
        if !(offset_y_pm is @NULL) { $.edit_obj(o, OFFSET_Y_PM, offset_y_pm) }
        if !(mod_front is @NULL) { $.edit_obj(o, MOD_FRONT, mod_front) }
        if !(mod_back is @NULL) { $.edit_obj(o, MOD_BACK, mod_back) }
        if !(deadzone is @NULL) { $.edit_obj(o, DEADZONE, deadzone) }
        if !(area_easing is @NULL) { $.edit_obj(o, AREA_EASING, area_easing) }
        if !(area_easing_rate is @NULL) { $.edit_obj(o, AREA_EASING_RATE, area_easing_rate) }
        if !(ease_out is @NULL) { $.edit_obj(o, EASE_OUT, ease_out) }
        if !(area_easing2 is @NULL) { $.edit_obj(o, AREA_EASING2, area_easing2) }
        if !(area_easing2_rate is @NULL) { $.edit_obj(o, AREA_EASING2_RATE, area_easing2_rate) }
        if !(dir_buttons_dir is @NULL) { $.edit_obj(o, DIR_BUTTONS_DIR, dir_buttons_dir) }
        if !(dir_buttons_inwards is @NULL) { $.edit_obj(o, DIR_BUTTONS_INWARDS, dir_buttons_inwards) }
        if !(dir_buttons_double_arrow is @NULL) { $.edit_obj(o, DIR_BUTTONS_DOUBLE_ARROW, dir_buttons_double_arrow) }
        if !(de_ap is @NULL) { $.edit_obj(o, DE_AP, de_ap) }
        if !(effect_id is @NULL) { $.edit_obj(o, EFFECT_ID, effect_id) }
        if !(center_group is @NULL) { $.edit_obj(o, CENTER_GROUP, center_group) }
        if !(priority is @NULL) { $.edit_obj(o, PRIORITY, priority) }
        if !(center_special is @NULL) { $.edit_obj(o, CENTER_SPECIAL, center_special) }
        if !(color_channel is @NULL) { $.edit_obj(o, COLOR_CHANNEL, color_channel) }
        if !(main_only is @NULL) { $.edit_obj(o, MAIN_ONLY, main_only) }
        if !(secondary_only is @NULL) { $.edit_obj(o, SECONDARY_ONLY, secondary_only) }
        $.edit_obj(o, TARGET_GROUP, self)
        $.add($.as_trigger(o))
    },

    advanced_follow: #[desc("Advanced follow trigger"), example("1g.advanced_follow(1g)")] (
        self,
        #[desc("follow group")] follow_group: @group | @trigger_function,
        #[desc("priority")] priority: @number | @NULL = null,
        #[desc("x only")] x_only: @bool | @NULL = null,
        #[desc("y only")] y_only: @bool | @NULL = null,
        #[desc("follow p1")] follow_p1: @bool | @NULL = null,
        #[desc("follow p2")] follow_p2: @bool | @NULL = null,
        #[desc("follow c")] follow_c: @bool | @NULL = null,
        #[desc("rot offset")] rot_offset: @number | @NULL = null,
        #[desc("rot easing")] rot_easing: @number | @NULL = null,
        #[desc("rot dead z")] rot_dead_z: @number | @NULL = null,
        #[desc("ignore disabled")] ignore_disabled: @bool | @NULL = null,
        #[desc("rotate dir")] rotate_dir: @bool | @NULL = null,
        #[desc("init set add Values: gd_enums.AdvancedFollowMode (INIT=0, SET=1, ADD=2).")] init_set_add: @number | @NULL = null,
        #[desc("exclusive")] exclusive: @bool | @NULL = null,
        #[desc("page 2 mode Values: gd_enums.AdvancedFollowPage2Mode (M0=0, M1=1, M2=2).")] page_2_mode: @number | @NULL = null,
        #[desc("delay")] delay: @number | @NULL = null,
        #[desc("delay pm")] delay_pm: @number | @NULL = null,
        #[desc("max speed")] max_speed: @number | @NULL = null,
        #[desc("max speed pm")] max_speed_pm: @number | @NULL = null,
        #[desc("max range")] max_range: @number | @NULL = null,
        #[desc("max range pm")] max_range_pm: @number | @NULL = null,
        #[desc("max range unmarked")] max_range_unmarked: @number | @NULL = null,
        #[desc("follow easing")] follow_easing: @number | @NULL = null,
        #[desc("follow easing pm")] follow_easing_pm: @number | @NULL = null,
        #[desc("start speed")] start_speed: @number | @NULL = null,
        #[desc("start speed pm")] start_speed_pm: @number | @NULL = null,
        #[desc("start speed unmarked")] start_speed_unmarked: @number | @NULL = null,
        #[desc("start dir")] start_dir: @number | @NULL = null,
        #[desc("start dir pm")] start_dir_pm: @number | @NULL = null,
        #[desc("start dir unmarked")] start_dir_unmarked: @number | @NULL = null,
        #[desc("acceleration")] acceleration: @number | @NULL = null,
        #[desc("acceleration pm")] acceleration_pm: @number | @NULL = null,
        #[desc("friction")] friction: @number | @NULL = null,
        #[desc("friction pm")] friction_pm: @number | @NULL = null,
        #[desc("near dist")] near_dist: @number | @NULL = null,
        #[desc("near dist pm")] near_dist_pm: @number | @NULL = null,
        #[desc("near friction")] near_friction: @number | @NULL = null,
        #[desc("near friction pm")] near_friction_pm: @number | @NULL = null,
        #[desc("near accel")] near_accel: @number | @NULL = null,
        #[desc("near accel pm")] near_accel_pm: @number | @NULL = null,
        #[desc("steer force")] steer_force: @number | @NULL = null,
        #[desc("steer force pm")] steer_force_pm: @number | @NULL = null,
        #[desc("steer force low")] steer_force_low: @number | @NULL = null,
        #[desc("steer force low pm")] steer_force_low_pm: @number | @NULL = null,
        #[desc("steer force low checkbox")] steer_force_low_checkbox: @bool | @NULL = null,
        #[desc("speed range low")] speed_range_low: @number | @NULL = null,
        #[desc("speed range low pm")] speed_range_low_pm: @number | @NULL = null,
        #[desc("steer force high")] steer_force_high: @number | @NULL = null,
        #[desc("steer force high pm")] steer_force_high_pm: @number | @NULL = null,
        #[desc("steer force high checkbox")] steer_force_high_checkbox: @bool | @NULL = null,
        #[desc("speed range high")] speed_range_high: @number | @NULL = null,
        #[desc("speed range high pm")] speed_range_high_pm: @number | @NULL = null,
        #[desc("break force")] break_force: @number | @NULL = null,
        #[desc("break force pm")] break_force_pm: @number | @NULL = null,
        #[desc("break angle")] break_angle: @number | @NULL = null,
        #[desc("break angle pm")] break_angle_pm: @number | @NULL = null,
        #[desc("break steer force")] break_steer_force: @number | @NULL = null,
        #[desc("break steer force pm")] break_steer_force_pm: @number | @NULL = null,
        #[desc("break steer speed limit")] break_steer_speed_limit: @number | @NULL = null,
        #[desc("break steer speed limit pm")] break_steer_speed_limit_pm: @number | @NULL = null,
        #[desc("target dir")] target_dir: @bool | @NULL = null,
    ) -> @NULL {
        let o = obj { OBJ_ID: 3016 }
        $.edit_obj(o, FOLLOW_GROUP, follow_group)
