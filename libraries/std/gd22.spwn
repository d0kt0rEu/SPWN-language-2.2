        #[desc("ignore x")] ignore_x: @bool | @NULL = null,
        #[desc("ignore y")] ignore_y: @bool | @NULL = null,
        #[desc("exit gravity Values: gd_enums.TeleportGravity (UNSET=0, NORMAL=1, FLIPPED=2, TOGGLE=3).")] exit_gravity: @number | @NULL = null,
        #[desc("instant camera")] instant_camera: @bool | @NULL = null,
        #[desc("snap ground")] snap_ground: @bool | @NULL = null,
