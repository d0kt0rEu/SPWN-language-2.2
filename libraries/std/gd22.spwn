        $.edit_obj(o, GROUP_ID_2, group_id_2)
        $.edit_obj(o, CHANCE, chance)
        $.add($.as_trigger(o))
    },

    camera_zoom_trigger: #[desc("Zooms the camera (returns the trigger as an object; add it with `$.add` or `.add()`)"), example("camera_zoom_trigger(1)")] (
        #[desc("zoom")] zoom: @number,
        #[desc("time")] time: @number = 0,
        #[desc("Easing type")] easing: @easing_type | @number | @NULL = null,
        #[desc("Easing rate")] easing_rate: @number | @NULL = null,
    ) -> @object {
        let o = obj { OBJ_ID: 1913 }
        $.edit_obj(o, ZOOM, zoom)
        $.edit_obj(o, TIME, time)
        if !(easing is @NULL) { $.edit_obj(o, EASING, _ev(easing)) }
        if !(easing_rate is @NULL) { $.edit_obj(o, EASING_RATE, _ev(easing_rate)) }
        return o
    },

    camera_zoom: #[desc("Zooms the camera"), example("camera_zoom(1)")] (
        #[desc("zoom")] zoom: @number,
        #[desc("time")] time: @number = 0,
        #[desc("Easing type")] easing: @easing_type | @number | @NULL = null,
        #[desc("Easing rate")] easing_rate: @number | @NULL = null,
    ) -> @NULL {
        let o = obj { OBJ_ID: 1913 }
        $.edit_obj(o, ZOOM, zoom)
        $.edit_obj(o, TIME, time)
        if !(easing is @NULL) { $.edit_obj(o, EASING, _ev(easing)) }
        if !(easing_rate is @NULL) { $.edit_obj(o, EASING_RATE, _ev(easing_rate)) }
        $.add($.as_trigger(o))
        wait(time)
    },

    camera_static_trigger: #[desc("Locks the camera to a group (returns the trigger as an object; add it with `$.add` or `.add()`)"), example("camera_static_trigger(1g)")] (
        #[desc("target group")] target_group: @group | @trigger_function,
        #[desc("duration")] duration: @number = 0,
        #[desc("follow")] follow: @bool | @NULL = null,
        #[desc("follow easing")] follow_easing: @number | @NULL = null,
        #[desc("smooth velocity")] smooth_velocity: @bool | @NULL = null,
        #[desc("smooth velocity modifier")] smooth_velocity_modifier: @number | @NULL = null,
        #[desc("exit instant")] exit_instant: @bool | @NULL = null,
        #[desc("exit static")] exit_static: @bool | @NULL = null,
        #[desc("Easing type")] easing: @easing_type | @number | @NULL = null,
        #[desc("Easing rate")] easing_rate: @number | @NULL = null,
    ) -> @object {
        let o = obj { OBJ_ID: 1914 }
        $.edit_obj(o, CAMERA_STATIC_TARGET_GROUP, target_group)
        $.edit_obj(o, DURATION, duration)
        if !(follow is @NULL) { $.edit_obj(o, CAMERA_STATIC_FOLLOW, follow) }
        if !(follow_easing is @NULL) { $.edit_obj(o, CAMERA_STATIC_FOLLOW_EASING, follow_easing) }
        if !(smooth_velocity is @NULL) { $.edit_obj(o, SMOOTH_VELOCITY, smooth_velocity) }
        if !(smooth_velocity_modifier is @NULL) { $.edit_obj(o, SMOOTH_VELOCITY_MODIFIER, smooth_velocity_modifier) }
        if !(exit_instant is @NULL) { $.edit_obj(o, EXIT_INSTANT, exit_instant) }
        if !(exit_static is @NULL) { $.edit_obj(o, EXIT_STATIC, exit_static) }
        if !(easing is @NULL) { $.edit_obj(o, EASING, _ev(easing)) }
        if !(easing_rate is @NULL) { $.edit_obj(o, EASING_RATE, _ev(easing_rate)) }
        return o
    },

