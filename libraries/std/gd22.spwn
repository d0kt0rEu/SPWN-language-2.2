    spawn_particle: #[desc("Spawns a particle system"), example("1g.spawn_particle()")] (
        self,
        #[desc("position group")] position_group: @group | @trigger_function | @NULL = null,
        #[desc("offset x")] offset_x: @number | @NULL = null,
        #[desc("offset y")] offset_y: @number | @NULL = null,
        #[desc("offvar x")] offvar_x: @number | @NULL = null,
        #[desc("offvar y")] offvar_y: @number | @NULL = null,
        #[desc("particle rotation")] particle_rotation: @number | @NULL = null,
        #[desc("particle rotation pm")] particle_rotation_pm: @number | @NULL = null,
        #[desc("particle scale")] particle_scale: @number | @NULL = null,
        #[desc("particle scale pm")] particle_scale_pm: @number | @NULL = null,
        #[desc("match rot")] match_rot: @bool | @NULL = null,
    ) -> @NULL {
        let o = obj { OBJ_ID: 3608 }
        if !(position_group is @NULL) { $.edit_obj(o, POSITION_GROUP, position_group) }
        if !(offset_x is @NULL) { $.edit_obj(o, SPAWN_PARTICLE_OFFSET_X, offset_x) }
        if !(offset_y is @NULL) { $.edit_obj(o, SPAWN_PARTICLE_OFFSET_Y, offset_y) }
        if !(offvar_x is @NULL) { $.edit_obj(o, OFFVAR_X, offvar_x) }
        if !(offvar_y is @NULL) { $.edit_obj(o, OFFVAR_Y, offvar_y) }
        if !(particle_rotation is @NULL) { $.edit_obj(o, PARTICLE_ROTATION, particle_rotation) }
        if !(particle_rotation_pm is @NULL) { $.edit_obj(o, PARTICLE_ROTATION_PM, particle_rotation_pm) }
        if !(particle_scale is @NULL) { $.edit_obj(o, PARTICLE_SCALE, particle_scale) }
        if !(particle_scale_pm is @NULL) { $.edit_obj(o, PARTICLE_SCALE_PM, particle_scale_pm) }
        if !(match_rot is @NULL) { $.edit_obj(o, MATCH_ROT, match_rot) }
        $.edit_obj(o, PARTICLE_GROUP, self)
        $.add($.as_trigger(o))
    },

    ui: #[desc("UI trigger: pins a group to a position on the screen"), example("1g.ui(1g)")] (
        self,
        #[desc("ui target")] ui_target: @group | @trigger_function,
        #[desc("xref pos Values: gd_enums.UIRef (DEFAULT=0, AUTO_X=1, CENTER_X=2, LEFT=3, RIGHT=4, AUTO_Y=5, CENTER_Y=6, BOTTOM=7, TOP=8).")] xref_pos: @number | @NULL = null,
        #[desc("yref pos Values: gd_enums.UIRef (DEFAULT=0, AUTO_X=1, CENTER_X=2, LEFT=3, RIGHT=4, AUTO_Y=5, CENTER_Y=6, BOTTOM=7, TOP=8).")] yref_pos: @number | @NULL = null,
        #[desc("xref relative")] xref_relative: @bool | @NULL = null,
        #[desc("yref relative")] yref_relative: @bool | @NULL = null,
    ) -> @NULL {
        let o = obj { OBJ_ID: 3613 }
        $.edit_obj(o, UI_TARGET, ui_target)
        if !(xref_pos is @NULL) { $.edit_obj(o, XREF_POS, xref_pos) }
        if !(yref_pos is @NULL) { $.edit_obj(o, YREF_POS, yref_pos) }
        if !(xref_relative is @NULL) { $.edit_obj(o, XREF_RELATIVE, xref_relative) }
        if !(yref_relative is @NULL) { $.edit_obj(o, YREF_RELATIVE, yref_relative) }
        $.edit_obj(o, GROUP_ID, self)
        $.add($.as_trigger(o))
    },

    reset: #[desc("Resets a group (sequence/random state)"), example("1g.reset()")] (
        self,
    ) -> @NULL {
        let o = obj { OBJ_ID: 3618 }
        $.edit_obj(o, GROUP_ID, self)
        $.add($.as_trigger(o))
    },

    edit_advanced_follow: #[desc("Edits the advanced follow of a group"), example("1g.edit_advanced_follow()")] (
        self,
        #[desc("x only")] x_only: @bool | @NULL = null,
        #[desc("y only")] y_only: @bool | @NULL = null,
        #[desc("mod x")] mod_x: @number | @NULL = null,
        #[desc("mod x pm")] mod_x_pm: @number | @NULL = null,
        #[desc("mod y")] mod_y: @number | @NULL = null,
        #[desc("mod y pm")] mod_y_pm: @number | @NULL = null,
        #[desc("speed")] speed: @number | @NULL = null,
        #[desc("speed pm")] speed_pm: @number | @NULL = null,
        #[desc("speed unmarked")] speed_unmarked: @number | @NULL = null,
        #[desc("dir")] dir: @number | @NULL = null,
        #[desc("dir pm")] dir_pm: @number | @NULL = null,
        #[desc("dir unmarked")] dir_unmarked: @number | @NULL = null,
        #[desc("target control id")] target_control_id: @bool | @NULL = null,
        #[desc("redirect dir")] redirect_dir: @bool | @NULL = null,
    ) -> @NULL {
        let o = obj { OBJ_ID: 3660 }
        if !(x_only is @NULL) { $.edit_obj(o, X_ONLY, x_only) }
        if !(y_only is @NULL) { $.edit_obj(o, Y_ONLY, y_only) }
        if !(mod_x is @NULL) { $.edit_obj(o, MOD_X, mod_x) }
        if !(mod_x_pm is @NULL) { $.edit_obj(o, MOD_X_PM, mod_x_pm) }
        if !(mod_y is @NULL) { $.edit_obj(o, MOD_Y, mod_y) }
        if !(mod_y_pm is @NULL) { $.edit_obj(o, MOD_Y_PM, mod_y_pm) }
        if !(speed is @NULL) { $.edit_obj(o, EDIT_ADVANCED_FOLLOW_SPEED, speed) }
        if !(speed_pm is @NULL) { $.edit_obj(o, SPEED_PM, speed_pm) }
        if !(speed_unmarked is @NULL) { $.edit_obj(o, SPEED_UNMARKED, speed_unmarked) }
        if !(dir is @NULL) { $.edit_obj(o, DIR, dir) }
        if !(dir_pm is @NULL) { $.edit_obj(o, DIR_PM, dir_pm) }
        if !(dir_unmarked is @NULL) { $.edit_obj(o, DIR_UNMARKED, dir_unmarked) }
        if !(target_control_id is @NULL) { $.edit_obj(o, TARGET_CONTROL_ID, target_control_id) }
        if !(redirect_dir is @NULL) { $.edit_obj(o, REDIRECT_DIR, redirect_dir) }
        $.edit_obj(o, TARGET_GROUP, self)
        $.add($.as_trigger(o))
    },

    retarget_advanced_follow: #[desc("Changes what an advanced follow follows"), example("1g.retarget_advanced_follow(1g)")] (
        self,
        #[desc("follow group")] follow_group: @group | @trigger_function,
        #[desc("target control id")] target_control_id: @bool | @NULL = null,
        #[desc("follow p1")] follow_p1: @bool | @NULL = null,
        #[desc("follow p2")] follow_p2: @bool | @NULL = null,
        #[desc("follow c")] follow_c: @bool | @NULL = null,
    ) -> @NULL {
        let o = obj { OBJ_ID: 3661 }
        $.edit_obj(o, FOLLOW_GROUP, follow_group)
        if !(target_control_id is @NULL) { $.edit_obj(o, TARGET_CONTROL_ID, target_control_id) }
        if !(follow_p1 is @NULL) { $.edit_obj(o, FOLLOW_P1, follow_p1) }
        if !(follow_p2 is @NULL) { $.edit_obj(o, FOLLOW_P2, follow_p2) }
        if !(follow_c is @NULL) { $.edit_obj(o, FOLLOW_C, follow_c) }
        $.edit_obj(o, TARGET_GROUP, self)
        $.add($.as_trigger(o))
    },

    pause: #[desc("Pauses everything that is running on this group (stop trigger in pause mode)"), example("1g.pause()")]
    (self) -> @NULL {
        let o = obj { OBJ_ID: 1616 }
        $.edit_obj(o, TARGET, self)
        $.edit_obj(o, STOP_PAUSE_RESUME, 1)
        $.add($.as_trigger(o))
    },

    resume: #[desc("Resumes everything that was paused on this group (stop trigger in resume mode)"), example("1g.resume()")]
    (self) -> @NULL {
        let o = obj { OBJ_ID: 1616 }
        $.edit_obj(o, TARGET, self)
        $.edit_obj(o, STOP_PAUSE_RESUME, 2)
        $.add($.as_trigger(o))
    },
}

