    keyframe_point_trigger: #[desc("Keyframe point object (returns the trigger as an object; add it with `$.add` or `.add()`)"), example("keyframe_point_trigger()")] (
        #[desc("duration")] duration: @number | @NULL = null,
        #[desc("group id")] group_id: @group | @trigger_function | @NULL = null,
        #[desc("x360")] x360: @number | @NULL = null,
        #[desc("spawn gid")] spawn_gid: @group | @trigger_function | @NULL = null,
        #[desc("spawn delay")] spawn_delay: @number | @NULL = null,
        #[desc("curve")] curve: @bool | @NULL = null,
        #[desc("cw ccw Values: gd_enums.KeyframeRotDir (UNSET=0, CW=1, CCW=2).")] cw_ccw: @number | @NULL = null,
        #[desc("time even dist Values: gd_enums.KeyframeMode (TIME=0, EVEN=1, DIST=2).")] time_even_dist: @number | @NULL = null,
        #[desc("prox")] prox: @bool | @NULL = null,
        #[desc("ref only")] ref_only: @bool | @NULL = null,
        #[desc("auto layer")] auto_layer: @bool | @NULL = null,
        #[desc("preview art")] preview_art: @bool | @NULL = null,
        #[desc("close loop")] close_loop: @bool | @NULL = null,
        #[desc("anim id")] anim_id: @number | @NULL = null,
        #[desc("order index")] order_index: @number | @NULL = null,
        #[desc("line opacity")] line_opacity: @number | @NULL = null,
    ) -> @object {
        let o = obj { OBJ_ID: 3032 }
        if !(duration is @NULL) { $.edit_obj(o, DURATION, duration) }
        if !(group_id is @NULL) { $.edit_obj(o, GROUP_ID, group_id) }
        if !(x360 is @NULL) { $.edit_obj(o, X360, x360) }
        if !(spawn_gid is @NULL) { $.edit_obj(o, SPAWN_GID, spawn_gid) }
        if !(spawn_delay is @NULL) { $.edit_obj(o, SPAWN_DELAY, spawn_delay) }
        if !(curve is @NULL) { $.edit_obj(o, CURVE, curve) }
        if !(cw_ccw is @NULL) { $.edit_obj(o, CW_CCW, cw_ccw) }
        if !(time_even_dist is @NULL) { $.edit_obj(o, TIME_EVEN_DIST, time_even_dist) }
        if !(prox is @NULL) { $.edit_obj(o, PROX, prox) }
        if !(ref_only is @NULL) { $.edit_obj(o, REF_ONLY, ref_only) }
        if !(auto_layer is @NULL) { $.edit_obj(o, AUTO_LAYER, auto_layer) }
        if !(preview_art is @NULL) { $.edit_obj(o, PREVIEW_ART, preview_art) }
        if !(close_loop is @NULL) { $.edit_obj(o, CLOSE_LOOP, close_loop) }
        if !(anim_id is @NULL) { $.edit_obj(o, ANIM_ID, anim_id) }
        if !(order_index is @NULL) { $.edit_obj(o, ORDER_INDEX, order_index) }
        if !(line_opacity is @NULL) { $.edit_obj(o, LINE_OPACITY, line_opacity) }
        return o
    },

