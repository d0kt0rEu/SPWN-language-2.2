        if !(page_2_mode is @NULL) { $.edit_obj(o, PAGE_2_MODE, page_2_mode) }
        if !(delay is @NULL) { $.edit_obj(o, ADVANCED_FOLLOW_DELAY, delay) }
        if !(delay_pm is @NULL) { $.edit_obj(o, DELAY_PM, delay_pm) }
        if !(max_speed is @NULL) { $.edit_obj(o, ADVANCED_FOLLOW_MAX_SPEED, max_speed) }
        if !(max_speed_pm is @NULL) { $.edit_obj(o, MAX_SPEED_PM, max_speed_pm) }
