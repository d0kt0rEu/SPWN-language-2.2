        if !(max_range_pm is @NULL) { $.edit_obj(o, MAX_RANGE_PM, max_range_pm) }
        if !(max_range_unmarked is @NULL) { $.edit_obj(o, MAX_RANGE_UNMARKED, max_range_unmarked) }
        if !(follow_easing is @NULL) { $.edit_obj(o, FOLLOW_EASING, follow_easing) }
        if !(follow_easing_pm is @NULL) { $.edit_obj(o, FOLLOW_EASING_PM, follow_easing_pm) }
        if !(start_speed is @NULL) { $.edit_obj(o, START_SPEED, start_speed) }
        if !(start_speed_pm is @NULL) { $.edit_obj(o, START_SPEED_PM, start_speed_pm) }
        if !(start_speed_unmarked is @NULL) { $.edit_obj(o, START_SPEED_UNMARKED, start_speed_unmarked) }
        if !(start_dir is @NULL) { $.edit_obj(o, START_DIR, start_dir) }
        if !(start_dir_pm is @NULL) { $.edit_obj(o, START_DIR_PM, start_dir_pm) }
        if !(start_dir_unmarked is @NULL) { $.edit_obj(o, START_DIR_UNMARKED, start_dir_unmarked) }
        if !(acceleration is @NULL) { $.edit_obj(o, ACCELERATION, acceleration) }
        if !(acceleration_pm is @NULL) { $.edit_obj(o, ACCELERATION_PM, acceleration_pm) }
        if !(friction is @NULL) { $.edit_obj(o, FRICTION, friction) }
        if !(friction_pm is @NULL) { $.edit_obj(o, FRICTION_PM, friction_pm) }
        if !(near_dist is @NULL) { $.edit_obj(o, NEAR_DIST, near_dist) }
        if !(near_dist_pm is @NULL) { $.edit_obj(o, NEAR_DIST_PM, near_dist_pm) }
        if !(near_friction is @NULL) { $.edit_obj(o, NEAR_FRICTION, near_friction) }
        if !(near_friction_pm is @NULL) { $.edit_obj(o, NEAR_FRICTION_PM, near_friction_pm) }
        if !(near_accel is @NULL) { $.edit_obj(o, NEAR_ACCEL, near_accel) }
        if !(near_accel_pm is @NULL) { $.edit_obj(o, NEAR_ACCEL_PM, near_accel_pm) }
        if !(steer_force is @NULL) { $.edit_obj(o, STEER_FORCE, steer_force) }
        if !(steer_force_pm is @NULL) { $.edit_obj(o, STEER_FORCE_PM, steer_force_pm) }
        if !(steer_force_low is @NULL) { $.edit_obj(o, STEER_FORCE_LOW, steer_force_low) }
        if !(steer_force_low_pm is @NULL) { $.edit_obj(o, STEER_FORCE_LOW_PM, steer_force_low_pm) }
        if !(steer_force_low_checkbox is @NULL) { $.edit_obj(o, STEER_FORCE_LOW_CHECKBOX, steer_force_low_checkbox) }
