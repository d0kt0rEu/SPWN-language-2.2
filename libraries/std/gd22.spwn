    random_trigger: #[desc("Spawns one of two groups at random (returns the trigger as an object; add it with `$.add` or `.add()`)"), example("random_trigger(1g, 1g)")] (
        #[desc("group id 1")] group_id_1: @group | @trigger_function,
        #[desc("group id 2")] group_id_2: @group | @trigger_function,
        #[desc("chance")] chance: @number = 50,
    ) -> @object {
        let o = obj { OBJ_ID: 1912 }
        $.edit_obj(o, GROUP_ID_1, group_id_1)
        $.edit_obj(o, GROUP_ID_2, group_id_2)
        $.edit_obj(o, CHANCE, chance)
        return o
    },

    random: #[desc("Spawns one of two groups at random"), example("random(1g, 1g)")] (
        #[desc("group id 1")] group_id_1: @group | @trigger_function,
