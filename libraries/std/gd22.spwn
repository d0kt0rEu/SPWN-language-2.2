    sfx_trigger: #[desc("Plays a sound effect (returns the trigger as an object; add it with `$.add` or `.add()`)"), example("sfx_trigger(1)")] (
        #[desc("sfx id")] sfx_id: @number,
        #[desc("affected by changing sfx, speed, start/end")] sound_duration: @number | @NULL = null,
        #[desc("speed")] speed: @number | @NULL = null,
        #[desc("pitch")] pitch: @number | @NULL = null,
        #[desc("volume")] volume: @number | @NULL = null,
        #[desc("reverb")] reverb: @bool | @NULL = null,
        #[desc("reverb type See gd_enums.ReverbType.")] reverb_type: @number | @NULL = null,
        #[desc("reverb enable")] reverb_enable: @bool | @NULL = null,
        #[desc("fft")] fft: @bool | @NULL = null,
        #[desc("loop")] loop: @bool | @NULL = null,
        #[desc("pre load")] pre_load: @bool | @NULL = null,
        #[desc("start")] start: @number | @NULL = null,
        #[desc("end")] end: @number | @NULL = null,
        #[desc("fade in")] fade_in: @number | @NULL = null,
        #[desc("fade out")] fade_out: @number | @NULL = null,
        #[desc("unique id")] unique_id: @number | @NULL = null,
        #[desc("sfx group")] sfx_group: @number | @NULL = null,
        #[desc("is unique")] is_unique: @bool | @NULL = null,
        #[desc("override")] override: @bool | @NULL = null,
        #[desc("min interval")] min_interval: @number | @NULL = null,
        #[desc("ignore volume test")] ignore_volume_test: @bool | @NULL = null,
        #[desc("group id 1")] group_id_1: @group | @trigger_function | @NULL = null,
        #[desc("group id 2")] group_id_2: @group | @trigger_function | @NULL = null,
        #[desc("p1")] p1: @bool | @NULL = null,
        #[desc("p2")] p2: @bool | @NULL = null,
        #[desc("cam")] cam: @bool | @NULL = null,
        #[desc("vol near")] vol_near: @number | @NULL = null,
        #[desc("vol med")] vol_med: @number | @NULL = null,
        #[desc("vol far")] vol_far: @number | @NULL = null,
        #[desc("min dist")] min_dist: @number | @NULL = null,
        #[desc("dist 2")] dist_2: @number | @NULL = null,
        #[desc("dist 3")] dist_3: @number | @NULL = null,
        #[desc("dir buttons Values: gd_enums.SoundDirs (ALL=0, LEFT_RIGHT=1, LEFT=2, RIGHT=3, UP_DOWN=4, DOWN=5, UP=6).")] dir_buttons: @number | @NULL = null,
        #[desc("speed pm")] speed_pm: @number | @NULL = null,
        #[desc("pitch pm")] pitch_pm: @number | @NULL = null,
        #[desc("volume pm")] volume_pm: @number | @NULL = null,
        #[desc("pitch steps")] pitch_steps: @bool | @NULL = null,
    ) -> @object {
        let o = obj { OBJ_ID: 3602 }
        $.edit_obj(o, SFX_ID, sfx_id)
        if !(sound_duration is @NULL) { $.edit_obj(o, SOUND_DURATION, sound_duration) }
        if !(speed is @NULL) { $.edit_obj(o, SFX_SPEED, speed) }
        if !(pitch is @NULL) { $.edit_obj(o, PITCH, pitch) }
        if !(volume is @NULL) { $.edit_obj(o, VOLUME, volume) }
        if !(reverb is @NULL) { $.edit_obj(o, REVERB, reverb) }
        if !(reverb_type is @NULL) { $.edit_obj(o, REVERB_TYPE, reverb_type) }
        if !(reverb_enable is @NULL) { $.edit_obj(o, REVERB_ENABLE, reverb_enable) }
        if !(fft is @NULL) { $.edit_obj(o, FFT, fft) }
        if !(loop is @NULL) { $.edit_obj(o, LOOP, loop) }
        if !(pre_load is @NULL) { $.edit_obj(o, PRE_LOAD, pre_load) }
        if !(start is @NULL) { $.edit_obj(o, START, start) }
        if !(end is @NULL) { $.edit_obj(o, END, end) }
        if !(fade_in is @NULL) { $.edit_obj(o, SFX_FADE_IN, fade_in) }
        if !(fade_out is @NULL) { $.edit_obj(o, SFX_FADE_OUT, fade_out) }
        if !(unique_id is @NULL) { $.edit_obj(o, UNIQUE_ID, unique_id) }
        if !(sfx_group is @NULL) { $.edit_obj(o, SFX_GROUP, sfx_group) }
        if !(is_unique is @NULL) { $.edit_obj(o, IS_UNIQUE, is_unique) }
        if !(override is @NULL) { $.edit_obj(o, OVERRIDE, override) }
