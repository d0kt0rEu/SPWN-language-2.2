        if !(speed_range_low_pm is @NULL) { $.edit_obj(o, SPEED_RANGE_LOW_PM, speed_range_low_pm) }
        if !(steer_force_high is @NULL) { $.edit_obj(o, STEER_FORCE_HIGH, steer_force_high) }
        if !(steer_force_high_pm is @NULL) { $.edit_obj(o, STEER_FORCE_HIGH_PM, steer_force_high_pm) }
        if !(steer_force_high_checkbox is @NULL) { $.edit_obj(o, STEER_FORCE_HIGH_CHECKBOX, steer_force_high_checkbox) }
        if !(speed_range_high is @NULL) { $.edit_obj(o, SPEED_RANGE_HIGH, speed_range_high) }
        if !(speed_range_high_pm is @NULL) { $.edit_obj(o, SPEED_RANGE_HIGH_PM, speed_range_high_pm) }
        if !(break_force is @NULL) { $.edit_obj(o, BREAK_FORCE, break_force) }
        if !(break_force_pm is @NULL) { $.edit_obj(o, BREAK_FORCE_PM, break_force_pm) }
        if !(break_angle is @NULL) { $.edit_obj(o, BREAK_ANGLE, break_angle) }
        if !(break_angle_pm is @NULL) { $.edit_obj(o, BREAK_ANGLE_PM, break_angle_pm) }
        if !(break_steer_force is @NULL) { $.edit_obj(o, BREAK_STEER_FORCE, break_steer_force) }
